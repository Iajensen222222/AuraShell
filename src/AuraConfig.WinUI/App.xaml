<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AuraConfig.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AuraConfig">
    <Application.Resources>
        <!--
            All custom resources are defined as plain (non-ThemeDictionary) entries.

            WHY: In unpackaged WinUI 3 2.0.1 apps bootstrapped via Bootstrap.Initialize,
            explicit ms-appx: URIs (used by XamlControlsResources and ThemeDictionaries
            MergedDictionaries) fail to resolve. Defining custom ThemeDictionaries at
            Application scope also shadows WinUI's built-in per-control theme keys
            (TabViewScrollButtonBackground, InfoBar*, ToggleSwitch*, etc.), crashing any
            page that uses those controls.

            By using plain resources with NO ThemeDictionaries, WinUI controls use their
            built-in theme exclusively (no shadowing), and our pages still find these
            brush keys via {ThemeResource}'s fallback from ThemeDictionary → plain resources.

            Dark-mode values are used (the app's primary theme).
        -->
        <ResourceDictionary>

            <!-- ── Custom brushes (dark theme values) ─────────────────────────── -->

            <!--
                TextBox focused-state override: WinUI 3 unpackaged resolves TextControlBackgroundFocused
                from system (light) resources even when RequestedTheme=Dark is set on a parent.
                Declaring these as plain App resources forces the correct values per theme.
                ThemeService.UpdateBrushColors swaps these when the user changes theme.
            -->
            <SolidColorBrush x:Key="TextControlBackground"                    Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver"          Color="#15FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused"              Color="#FF1C1C1C" />
            <SolidColorBrush x:Key="TextControlForeground"                     Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver"          Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlForegroundFocused"              Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground"          Color="#72FFFFFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#87FFFFFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"   Color="#72FFFFFF" />

            <SolidColorBrush x:Key="TextFillColorSecondaryBrush"              Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"    Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"            Color="#19000000" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"        Color="#60CDFF"   />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush"            Color="#FCE100"   />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush"            Color="#6CCB5F"   />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush"  Color="#393D1B"   />
            <!-- ThemesPage requires these two keys missing from WinUI 3 unpackaged resources -->
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"         Color="#18FFFFFF" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush"  Color="#30FCE100" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush"           Color="#FF99A4"   />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#442726"   />
            <!-- DesktopItemsPage highlights the drop zone with this key on drag-enter. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush"            Color="#60CDFF"   />

            <!-- ── App palette (dark values; ThemeService swaps them for light) ── -->
            <SolidColorBrush x:Key="AppTextPrimaryBrush"        Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppAccentFillBrush"         Color="#FF60CDFF" />
            <SolidColorBrush x:Key="AppAccentFillHoverBrush"    Color="#E660CDFF" />
            <SolidColorBrush x:Key="AppAccentFillPressedBrush"  Color="#CC60CDFF" />
            <SolidColorBrush x:Key="AppAccentTextBrush"         Color="#FF000000" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush"       Color="#2660CDFF" />
            <SolidColorBrush x:Key="AppSubtleHoverBrush"        Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="AppSubtlePressedBrush"      Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="AppNavSelectedBrush"        Color="#14FFFFFF" />
            <SolidColorBrush x:Key="AppDropZoneBrush"           Color="#06FFFFFF" />

            <!--
                Lightweight-styling overrides for the built-in control templates. Same
                mechanism as the TextControl* keys above: plain keys the default templates
                pick up, swapped per theme by ThemeService. They give buttons Fluent fills
                and make toggles, sliders and radio buttons use the app accent instead of
                whatever the Windows accent color happens to be.
            -->
            <SolidColorBrush x:Key="ButtonBackground"                 Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"      Color="#15FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed"          Color="#08FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled"         Color="#0BFFFFFF" />
            <SolidColorBrush x:Key="ButtonForeground"                 Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver"      Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed"          Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled"         Color="#5DFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush"                Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"     Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed"         Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled"        Color="#12FFFFFF" />

            <SolidColorBrush x:Key="ToggleButtonBackground"                     Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver"          Color="#15FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed"              Color="#08FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForeground"                     Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver"          Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPressed"              Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush"                    Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver"         Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed"             Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked"              Color="#FF60CDFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver"   Color="#E660CDFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed"       Color="#CC60CDFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked"              Color="#FF000000" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver"   Color="#FF000000" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed"       Color="#CC000000" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked"             Color="#00000000" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver"  Color="#00000000" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed"      Color="#00000000" />

            <SolidColorBrush x:Key="HyperlinkButtonForeground"            Color="#FF60CDFF" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#FF99EBFF" />
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed"     Color="#CC60CDFF" />

            <SolidColorBrush x:Key="TimePickerButtonBackground"            Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="TimePickerButtonBackgroundPointerOver" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="TimePickerButtonBackgroundPressed"     Color="#08FFFFFF" />
            <SolidColorBrush x:Key="TimePickerButtonBorderBrush"            Color="#24FFFFFF" />
            <SolidColorBrush x:Key="TimePickerButtonBorderBrushPointerOver" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="TimePickerButtonBorderBrushPressed"     Color="#24FFFFFF" />
            <SolidColorBrush x:Key="TimePickerSpacerFill"                   Color="#24FFFFFF" />

            <SolidColorBrush x:Key="TextControlBorderBrush"            Color="#24FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused"     Color="#FF60CDFF" />

            <SolidColorBrush x:Key="ComboBoxBackground"                Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"     Color="#15FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed"         Color="#08FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush"               Color="#24FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver"    Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed"        Color="#24FFFFFF" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn"                Color="#FF60CDFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver"     Color="#E660CDFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"         Color="#CC60CDFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"            Color="#FF000000" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FF000000" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"     Color="#FF000000" />

            <SolidColorBrush x:Key="SliderTrackValueFill"              Color="#FF60CDFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver"   Color="#FF60CDFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed"       Color="#FF60CDFF" />
            <SolidColorBrush x:Key="SliderThumbBackground"             Color="#FF60CDFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver"  Color="#E660CDFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed"      Color="#CC60CDFF" />

            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke"            Color="#FF60CDFF" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#E660CDFF" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed"     Color="#CC60CDFF" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill"              Color="#FF60CDFF" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver"   Color="#E660CDFF" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed"       Color="#CC60CDFF" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFill"                       Color="#FF000000" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver"            Color="#FF000000" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed"                Color="#FF000000" />

            <!-- ── Text styles (WinUI type-ramp values) ───────────────────────── -->
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Small" />
            </Style>
            <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            </Style>
            <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            </Style>
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            </Style>

            <!-- ── Page layout styles shared by every page ─────────────────────── -->
            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            </Style>
            <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="14" />
                <Setter Property="FontFamily"   Value="Segoe UI Variable Text" />
                <Setter Property="Foreground"   Value="{StaticResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin"       Value="0,4,0,0" />
            </Style>
            <!-- Accent, letter-spaced label above a group of cards. -->
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize"         Value="12" />
                <Setter Property="FontFamily"       Value="Segoe UI Variable Small" />
                <Setter Property="FontWeight"       Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground"       Value="{StaticResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="Margin"           Value="2,22,0,4" />
            </Style>
            <!-- Title and helper text of one setting row. -->
            <Style x:Key="SettingTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="14" />
                <Setter Property="FontFamily"   Value="Segoe UI Variable Text" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SettingDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="12" />
                <Setter Property="FontFamily"   Value="Segoe UI Variable Small" />
                <Setter Property="Foreground"   Value="{StaticResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin"       Value="0,2,0,0" />
            </Style>
            <!-- Current value shown to the left of a row slider ("48 px"). -->
            <Style x:Key="SliderValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize"          Value="13" />
                <Setter Property="FontFamily"        Value="Segoe UI Variable Text" />
                <Setter Property="Foreground"        Value="{StaticResource TextFillColorSecondaryBrush}" />
                <Setter Property="MinWidth"          Value="56" />
                <Setter Property="TextAlignment"     Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin"            Value="0,0,12,0" />
            </Style>
            <!-- Slider in the right-hand column of a setting row. -->
            <Style x:Key="RowSliderStyle" TargetType="Slider">
                <Setter Property="Width"             Value="220" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Root column of every page: cards stack with a small gap, capped width. -->
            <Style x:Key="PageStackStyle" TargetType="StackPanel">
                <Setter Property="Spacing"  Value="4" />
                <Setter Property="MaxWidth" Value="1000" />
            </Style>
            <Style x:Key="PageScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Padding" Value="36,4,36,36" />
            </Style>
            <!-- Leading glyph of a setting row. -->
            <Style x:Key="SettingIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize"          Value="20" />
                <Setter Property="Width"             Value="24" />
                <Setter Property="Margin"            Value="0,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- A settings card: one rounded tile per setting or group of settings. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background"      Value="{StaticResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush"     Value="{StaticResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius"    Value="8" />
                <Setter Property="Padding"         Value="16,14" />
            </Style>
            <!-- Thin line between rows that share one card (cancels the card's side padding). -->
            <Style x:Key="CardDividerStyle" TargetType="Border">
                <Setter Property="Height"     Value="1" />
                <Setter Property="Margin"     Value="-16,0" />
                <Setter Property="Background" Value="{StaticResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <!-- Toggle at the right edge of a setting row: no header and no On/Off text. -->
            <Style x:Key="RowToggleSwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="OnContent"           Value="" />
                <Setter Property="OffContent"          Value="" />
                <!-- The template reserves room for On/Off text (MinWidth 154 inside it), so the
                     width must be pinned to the track. The Windows App SDK 2.0 track is 44 px
                     wide; 40 cut off its right end. -->
                <Setter Property="MinWidth"            Value="0" />
                <Setter Property="Width"               Value="44" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment"   Value="Center" />
                <Setter Property="Margin"              Value="16,0,0,0" />
            </Style>

            <!-- ── Implicit control styles: Fluent corner radius on built-in controls ── -->
            <Style TargetType="Button">
                <Setter Property="CornerRadius"    Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding"         Value="12,5,12,6" />
            </Style>
            <Style TargetType="ToggleButton">
                <Setter Property="CornerRadius"    Value="4" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="TimePicker">
                <Setter Property="CornerRadius"    Value="4" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="CornerRadius"    Value="4" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="CornerRadius"    Value="4" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!--
                Accent button. A full template (not just setters) so hover and press tint
                the accent color instead of falling back to the gray ButtonBackground* keys.
            -->
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background"            Value="{StaticResource AppAccentFillBrush}" />
                <Setter Property="Foreground"            Value="{StaticResource AppAccentTextBrush}" />
                <Setter Property="BorderThickness"       Value="0" />
                <Setter Property="CornerRadius"          Value="4" />
                <Setter Property="Padding"               Value="12,6,12,7" />
                <Setter Property="FontSize"              Value="14" />
                <Setter Property="FontFamily"            Value="Segoe UI Variable Text" />
                <Setter Property="FontWeight"            Value="SemiBold" />
                <Setter Property="HorizontalAlignment"   Value="Left" />
                <Setter Property="VerticalAlignment"     Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin"     Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource AppAccentFillHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource AppAccentFillPressedBrush}" />
                                                <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Borderless button for icon buttons and nav rows: transparent until hovered. -->
            <Style x:Key="SubtleButtonStyle" TargetType="Button">
                <Setter Property="Background"            Value="Transparent" />
                <Setter Property="Foreground"            Value="{StaticResource AppTextPrimaryBrush}" />
                <Setter Property="BorderThickness"       Value="0" />
                <Setter Property="CornerRadius"          Value="4" />
                <Setter Property="Padding"               Value="8,6" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Overlay.Background" Value="{StaticResource AppSubtleHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Overlay.Background" Value="{StaticResource AppSubtlePressedBrush}" />
                                                <Setter Target="ContentPresenter.Opacity" Value="0.75" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Overlay"
                                        Background="Transparent"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Desktop FX: effect rows and effect pages ──────────────────── -->
            <!-- A card holding one clickable effect row (the row button supplies the padding). -->
            <Style x:Key="EffectRowCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="EffectRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="HorizontalAlignment"        Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding"                    Value="16,12" />
                <Setter Property="CornerRadius"               Value="8" />
            </Style>
            <!-- Sits over the row button, left of its chevron (16 padding + 14 chevron + 16 gap). -->
            <Style x:Key="EffectRowToggleSwitchStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource RowToggleSwitchStyle}">
                <Setter Property="Margin" Value="0,0,46,0" />
            </Style>
            <!-- Small dark tile that shows what an effect looks like. -->
            <Style x:Key="EffectThumbStyle" TargetType="Border">
                <Setter Property="Width"        Value="64" />
                <Setter Property="Height"       Value="44" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background"   Value="#FF101418" />
            </Style>
            <!-- Live preview box at the top of an effect page: a dark stand-in for the desktop. -->
            <Style x:Key="EffectPreviewStyle" TargetType="Border">
                <Setter Property="CornerRadius"    Value="8" />
                <Setter Property="Background"      Value="#FF101418" />
                <Setter Property="BorderBrush"     Value="{StaticResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <!-- "Desktop FX › Effect name" header of an effect page. -->
            <Style x:Key="BreadcrumbParentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleTextStyle}">
                <Setter Property="FontSize"   Value="28" />
                <Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="BreadcrumbTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleTextStyle}">
                <Setter Property="FontSize"          Value="28" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
