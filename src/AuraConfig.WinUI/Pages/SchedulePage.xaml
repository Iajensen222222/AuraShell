<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AuraConfig.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">

            <StackPanel Margin="0,0,0,4">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Schedule" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                           Text="Switch themes automatically by day and time, for example a calmer theme in the evening." />
            </StackPanel>

            <TextBlock Text="AUTOMATIC SWITCHING" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE823;" Style="{StaticResource SettingIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Use the schedule" />
                        <TextBlock x:Name="NextChangeText"
                                   Style="{StaticResource SettingDescriptionTextStyle}"
                                   Text="No upcoming scheduled changes" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SchedulerEnabled" Grid.Column="2"
                                  Style="{StaticResource RowToggleSwitchStyle}"
                                  IsOn="True"
                                  Toggled="SchedulerEnabled_Toggled" />
                </Grid>
            </Border>

            <Grid Margin="0,22,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="RULES" Style="{StaticResource SectionHeaderTextStyle}"
                           Margin="2,0,0,0" VerticalAlignment="Bottom" />
                <Button Grid.Column="1" Click="AddRule_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="Add rule" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel x:Name="RulesList" Spacing="4" />

            <!-- Empty state -->
            <Border x:Name="EmptyState"
                    Style="{StaticResource CardStyle}"
                    Padding="24,32"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE787;" FontSize="32"
                              Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="No rules yet"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="Add a rule to pick the days, the time range and the theme to use."
                               Style="{StaticResource SettingDescriptionTextStyle}"
                               TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Save schedule"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SaveRules_Click" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource SettingDescriptionTextStyle}"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="Rule changes take effect when you save." />
            </Grid>

            <!-- Status banner -->
            <Border x:Name="StatusBanner"
                    Background="{StaticResource SystemFillColorSuccessBackgroundBrush}"
                    CornerRadius="4" Padding="12,8" Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="13"
                              Foreground="{StaticResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{StaticResource SystemFillColorSuccessBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
