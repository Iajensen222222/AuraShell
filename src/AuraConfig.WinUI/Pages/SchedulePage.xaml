<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AuraConfig.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16">

            <!-- Header -->
            <StackPanel Margin="0,0,0,4">
                <TextBlock FontSize="40" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display" Text="Schedule" />
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                           Text="Automatically switch themes at specific times"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <ToggleSwitch x:Name="SchedulerEnabled"
                          Header="Enable scheduled theme switching"
                          IsOn="True"
                          Toggled="SchedulerEnabled_Toggled" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE823;" FontSize="14"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="NextChangeText"
                               Text="No upcoming scheduled changes"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Text="RULES"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold"
                       Margin="0,8,0,0" />

            <StackPanel x:Name="RulesList" Spacing="8" />

            <TextBlock x:Name="EmptyState"
                       Text="No rules yet — click Add rule to create one."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Add rule" Click="AddRule_Click" />
                <Button Content="Save schedule"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="SaveRules_Click" />
            </StackPanel>

            <!-- Status banner -->
            <Border x:Name="StatusBanner"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                <TextBlock x:Name="StatusText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
