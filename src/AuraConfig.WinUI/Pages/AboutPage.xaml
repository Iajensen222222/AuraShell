<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AuraConfig.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingTitleTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="InfoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingTitleTextStyle}">
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">

            <StackPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="About" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                           Text="Version details, and what to include if you report a problem." />
            </StackPanel>

            <!-- Identity card -->
            <Border Style="{StaticResource CardStyle}" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="14"
                            Margin="0,0,20,0" VerticalAlignment="Top"
                            Background="{StaticResource AppAccentSubtleBrush}">
                        <FontIcon Glyph="&#xE734;" FontSize="32"
                                  Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="AuraShell" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{StaticResource AccentTextFillColorPrimaryBrush}"
                                   Text="Version 1.0.0" />
                        <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                   Margin="0,6,0,0"
                                   Text="Restyles and personalizes the Windows 11 desktop: window glow, desktop effects and themes." />
                        <HyperlinkButton Content="github.com/Iajensen222222/AuraShell"
                                         NavigateUri="https://github.com/Iajensen222222/AuraShell"
                                         Padding="0" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── SERVICE ────────────────────────────────────────────────── -->
            <TextBlock Text="SERVICE" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Status" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="SvcStatusText" Grid.Row="0" Grid.Column="1"
                               Text="—" Style="{StaticResource InfoValueStyle}" />

                    <TextBlock Grid.Row="1" Text="Version" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="SvcVersionText" Grid.Row="1" Grid.Column="1"
                               Text="—" Style="{StaticResource InfoValueStyle}" />

                    <TextBlock Grid.Row="2" Text="Running for" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="SvcUptimeText" Grid.Row="2" Grid.Column="1"
                               Text="—" Style="{StaticResource InfoValueStyle}" />
                </Grid>
            </Border>

            <!-- ── SYSTEM ─────────────────────────────────────────────────── -->
            <TextBlock Text="SYSTEM" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Windows" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="OsVersionText" Grid.Row="0" Grid.Column="1"
                               Text="—" Style="{StaticResource InfoValueStyle}" />

                    <TextBlock Grid.Row="1" Text="Window size" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="DpiText" Grid.Row="1" Grid.Column="1"
                               Text="—" Style="{StaticResource InfoValueStyle}" />

                    <TextBlock Grid.Row="2" Text=".NET runtime" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock x:Name="RuntimeText" Grid.Row="2" Grid.Column="1"
                               Text="—" Style="{StaticResource InfoValueStyle}" />
                </Grid>
            </Border>

            <!-- ── LICENSE ────────────────────────────────────────────────── -->
            <TextBlock Text="LICENSE" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource SettingTitleTextStyle}"
                               Text="MIT License, © 2026 AuraShell Development Team" />
                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                               Text="You may use, copy, modify and share this software." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
