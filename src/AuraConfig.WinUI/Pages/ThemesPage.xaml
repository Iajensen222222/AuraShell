<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.ThemesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AuraConfig.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="36,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,36,16">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Themes" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                       Text="A theme saves a glow color with its effects. Pick one to apply it, or duplicate a built-in theme to make it your own." />
        </StackPanel>

        <!-- ── LEFT: theme list ─────────────────────────────────────────── -->
        <Border Grid.Row="1" Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Padding="4"
                Margin="0,0,0,36">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Padding="0,0,0,4">
                    <StackPanel x:Name="ThemeListPanel" Spacing="2" />
                </ScrollViewer>

                <Border Grid.Row="1" Style="{StaticResource CardDividerStyle}"
                        Margin="-4,0" VerticalAlignment="Top" />
                <Button Grid.Row="1"
                        x:Name="NewThemeBtn"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="NewTheme_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,5,0,0"
                        Padding="12,9">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE710;" FontSize="14"
                                  Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="New theme" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── RIGHT: editor ────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Padding="20,0,36,36">
            <StackPanel>

                <!-- Nothing selected -->
                <StackPanel x:Name="NoSelectionPanel"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="0,80,0,0">
                    <FontIcon Glyph="&#xE771;" FontSize="40"
                              Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Pick a theme on the left"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="You can apply it right away, or change its color and effects."
                               Style="{StaticResource SettingDescriptionTextStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Editor (shown when a theme is selected) -->
                <StackPanel x:Name="EditorPanel" Visibility="Collapsed" Spacing="4" MaxWidth="760">

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ApplyBtn"
                                Click="Apply_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Use this theme now">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                <TextBlock Text="Apply" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DuplicateBtn"
                                Click="Duplicate_Click"
                                ToolTipService.ToolTip="Make an editable copy">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="Duplicate" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveBtn"
                                Click="Save_Click"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="Keep your changes to this theme">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteBtn"
                                Click="Delete_Click"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="Delete this theme">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Delete" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Status message -->
                    <Border x:Name="StatusBanner"
                            Background="{StaticResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="4" Padding="12,8" Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="13"
                                      Foreground="{StaticResource SystemFillColorSuccessBrush}" />
                            <TextBlock x:Name="StatusText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{StaticResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Built-in notice -->
                    <Border x:Name="BuiltInNoticeBorder"
                            Background="{StaticResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4" Padding="12,8" Margin="0,8,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72E;" FontSize="13" Margin="0,1,10,0"
                                      VerticalAlignment="Top"
                                      Foreground="{StaticResource SystemFillColorCautionBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="Built-in themes can't be changed. Click Duplicate to make a copy you can edit."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- ── BASICS ─────────────────────────────────────────── -->
                    <TextBlock Text="BASICS" Style="{StaticResource SectionHeaderTextStyle}" />

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8AC;" Style="{StaticResource SettingIconStyle}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingTitleTextStyle}"
                                           VerticalAlignment="Center" Text="Name" />
                                <TextBox x:Name="NameInput" Grid.Column="2"
                                         Width="240" Margin="16,0,0,0"
                                         PlaceholderText="e.g. Midnight Blue"
                                         AutomationProperties.Name="Theme name"
                                         TextChanged="NameInput_TextChanged" />
                            </Grid>
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Glow color" />
                                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                               Text="Click the swatch or type a hex code and press Enter." />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                                    <Button Padding="3"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Open color picker"
                                            AutomationProperties.Name="Open color picker"
                                            Click="ColorSwatch_Click">
                                        <Border x:Name="ColorSwatch"
                                                Width="26" Height="26" CornerRadius="3"
                                                Background="#FF0078D4" />
                                    </Button>
                                    <TextBox x:Name="ColorHexInput"
                                             PlaceholderText="#0078D4"
                                             Width="110"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="Glow color hex code"
                                             KeyDown="ColorHexInput_KeyDown" />
                                    <Button Content="Set" Click="ApplyColor_Click"
                                            ToolTipService.ToolTip="Use this hex code" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE916;" Style="{StaticResource SettingIconStyle}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingTitleTextStyle}"
                                           VerticalAlignment="Center" Text="Animation speed" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SliderValueTextStyle}"
                                           Text="{x:Bind local:Fmt.Times(SpeedSlider.Value), Mode=OneWay}" />
                                <Slider x:Name="SpeedSlider" Grid.Column="3"
                                        Style="{StaticResource RowSliderStyle}"
                                        AutomationProperties.Name="Animation speed"
                                        Minimum="0" Maximum="200" Value="100"
                                        ValueChanged="SpeedSlider_ValueChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── WINDOWS LOOK ───────────────────────────────────── -->
                    <TextBlock Text="WINDOWS LOOK" Style="{StaticResource SectionHeaderTextStyle}" />

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE91B;" Style="{StaticResource SettingIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Wallpaper" />
                                    <TextBlock x:Name="ThemeWallpaperText"
                                               Style="{StaticResource SettingDescriptionTextStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="Don't change the wallpaper" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                                    <ComboBox x:Name="ThemeFitCombo"
                                              Width="110"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Theme wallpaper fit"
                                              SelectionChanged="ThemeFitCombo_SelectionChanged">
                                        <ComboBoxItem Content="Fill" Tag="Fill" />
                                        <ComboBoxItem Content="Fit" Tag="Fit" />
                                        <ComboBoxItem Content="Stretch" Tag="Stretch" />
                                        <ComboBoxItem Content="Tile" Tag="Tile" />
                                        <ComboBoxItem Content="Center" Tag="Center" />
                                        <ComboBoxItem Content="Span" Tag="Span" />
                                    </ComboBox>
                                    <Button x:Name="ThemeWallpaperBtn" Content="Choose…"
                                            AutomationProperties.Name="Choose theme wallpaper"
                                            Click="ThemeWallpaper_Click" />
                                    <Button x:Name="ThemeWallpaperClearBtn" Content="None"
                                            AutomationProperties.Name="Theme keeps the current wallpaper"
                                            ToolTipService.ToolTip="Leave the wallpaper alone when applying this theme"
                                            Click="ThemeWallpaperClear_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Windows accent color" />
                                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                               Text="Set the Windows accent to this theme's glow color." />
                                </StackPanel>
                                <ToggleSwitch x:Name="ThemeAccentToggle" Grid.Column="2"
                                              Style="{StaticResource RowToggleSwitchStyle}"
                                              AutomationProperties.Name="Set the Windows accent to the glow color"
                                              Toggled="ThemeAccentToggle_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE793;" Style="{StaticResource SettingIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Windows mode" />
                                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                               Text="Switch Windows and apps to light or dark with this theme." />
                                </StackPanel>
                                <ComboBox x:Name="ThemeModeCombo" Grid.Column="2"
                                          Width="160" Margin="16,0,0,0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Theme Windows mode"
                                          SelectionChanged="ThemeModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Don't change" Tag="" />
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── WINDOW GLOW ────────────────────────────────────── -->
                    <TextBlock Text="WINDOW GLOW" Style="{StaticResource SectionHeaderTextStyle}" />

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7C9;" Style="{StaticResource SettingIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Glow effect" />
                                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                               Text="Draw the colored glow around window borders." />
                                </StackPanel>
                                <ToggleSwitch x:Name="GlowToggle" Grid.Column="2"
                                              Style="{StaticResource RowToggleSwitchStyle}"
                                              IsOn="True"
                                              Toggled="GlowToggle_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B0;" Style="{StaticResource SettingIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Highlight on hover" />
                                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                               Text="Brighten the glow when the mouse is over a window." />
                                </StackPanel>
                                <ToggleSwitch x:Name="HoverToggle" Grid.Column="2"
                                              Style="{StaticResource RowToggleSwitchStyle}"
                                              IsOn="True"
                                              Toggled="HoverToggle_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── AUDIO BAR ──────────────────────────────────────── -->
                    <TextBlock Text="AUDIO BAR" Style="{StaticResource SectionHeaderTextStyle}" />

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE767;" Style="{StaticResource SettingIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Audio visualizer bar" />
                                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                               Text="Bars along the taskbar that move with your music." />
                                </StackPanel>
                                <ToggleSwitch x:Name="VisualizerToggle" Grid.Column="2"
                                              Style="{StaticResource RowToggleSwitchStyle}"
                                              IsOn="True"
                                              Toggled="VisualizerToggle_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid Margin="40,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}"
                                           VerticalAlignment="Center" Text="Bar height" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SliderValueTextStyle}"
                                           Text="{x:Bind local:Fmt.Px(VisualizerHeightSlider.Value), Mode=OneWay}" />
                                <Slider x:Name="VisualizerHeightSlider" Grid.Column="2"
                                        Style="{StaticResource RowSliderStyle}"
                                        AutomationProperties.Name="Bar height in pixels"
                                        Minimum="40" Maximum="200" Value="80"
                                        ValueChanged="VisualizerHeightSlider_ValueChanged" />
                            </Grid>
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid Margin="40,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}"
                                           VerticalAlignment="Center" Text="Bar brightness" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SliderValueTextStyle}"
                                           Text="{x:Bind local:Fmt.Times(VisualizerBrightnessSlider.Value), Mode=OneWay}" />
                                <Slider x:Name="VisualizerBrightnessSlider" Grid.Column="2"
                                        Style="{StaticResource RowSliderStyle}"
                                        AutomationProperties.Name="Bar brightness"
                                        Minimum="0" Maximum="200" Value="100"
                                        ValueChanged="VisualizerBrightnessSlider_ValueChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── MONITORS ───────────────────────────────────────── -->
                    <TextBlock Text="MONITORS" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                               Margin="2,0,0,4"
                               Text="Turn the glow off on a display, or give it its own color. Leave the color empty to use the theme color." />

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <!-- Monitor 1: always visible -->
                            <Grid x:Name="MonitorRow0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingIconStyle}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingTitleTextStyle}"
                                           VerticalAlignment="Center" Text="Monitor 1 (main)" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                                    <TextBox x:Name="Mon0HexInput" PlaceholderText="Theme color" Width="120"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="Monitor 1 color"
                                             KeyDown="Mon0Hex_KeyDown" />
                                    <Button Content="Set" Click="Mon0Apply_Click" />
                                </StackPanel>
                                <ToggleSwitch x:Name="Mon0Toggle" Grid.Column="3"
                                              Style="{StaticResource RowToggleSwitchStyle}"
                                              AutomationProperties.Name="Glow on monitor 1"
                                              IsOn="True"
                                              Toggled="Mon0Toggle_Toggled" />
                            </Grid>

                            <!-- Monitor 2: shown when 2+ monitors are detected -->
                            <StackPanel x:Name="MonitorRow1" Spacing="14" Visibility="Collapsed">
                                <Border Style="{StaticResource CardDividerStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingIconStyle}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SettingTitleTextStyle}"
                                               VerticalAlignment="Center" Text="Monitor 2" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                                        <TextBox x:Name="Mon1HexInput" PlaceholderText="Theme color" Width="120"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="Monitor 2 color"
                                                 KeyDown="Mon1Hex_KeyDown" />
                                        <Button Content="Set" Click="Mon1Apply_Click" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="Mon1Toggle" Grid.Column="3"
                                                  Style="{StaticResource RowToggleSwitchStyle}"
                                                  AutomationProperties.Name="Glow on monitor 2"
                                                  IsOn="True"
                                                  Toggled="Mon1Toggle_Toggled" />
                                </Grid>
                            </StackPanel>

                            <!-- Monitor 3 -->
                            <StackPanel x:Name="MonitorRow2" Spacing="14" Visibility="Collapsed">
                                <Border Style="{StaticResource CardDividerStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingIconStyle}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SettingTitleTextStyle}"
                                               VerticalAlignment="Center" Text="Monitor 3" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                                        <TextBox x:Name="Mon2HexInput" PlaceholderText="Theme color" Width="120"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="Monitor 3 color"
                                                 KeyDown="Mon2Hex_KeyDown" />
                                        <Button Content="Set" Click="Mon2Apply_Click" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="Mon2Toggle" Grid.Column="3"
                                                  Style="{StaticResource RowToggleSwitchStyle}"
                                                  AutomationProperties.Name="Glow on monitor 3"
                                                  IsOn="True"
                                                  Toggled="Mon2Toggle_Toggled" />
                                </Grid>
                            </StackPanel>

                            <!-- Monitor 4 -->
                            <StackPanel x:Name="MonitorRow3" Spacing="14" Visibility="Collapsed">
                                <Border Style="{StaticResource CardDividerStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingIconStyle}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SettingTitleTextStyle}"
                                               VerticalAlignment="Center" Text="Monitor 4" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                                        <TextBox x:Name="Mon3HexInput" PlaceholderText="Theme color" Width="120"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="Monitor 4 color"
                                                 KeyDown="Mon3Hex_KeyDown" />
                                        <Button Content="Set" Click="Mon3Apply_Click" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="Mon3Toggle" Grid.Column="3"
                                                  Style="{StaticResource RowToggleSwitchStyle}"
                                                  AutomationProperties.Name="Glow on monitor 4"
                                                  IsOn="True"
                                                  Toggled="Mon3Toggle_Toggled" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
