<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.DesktopFxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AuraConfig.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">

            <StackPanel Margin="0,0,0,4">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Desktop FX" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                           Text="Pick an effect to customize it. The switch turns it on or off and keeps your settings." />
            </StackPanel>

            <TextBlock Text="EFFECTS" Style="{StaticResource SectionHeaderTextStyle}" />

            <!-- ── Icon hover glow row: the button opens the effect page, the toggle sits on top. -->
            <Border Style="{StaticResource EffectRowCardStyle}">
                <Grid>
                    <Button Style="{StaticResource EffectRowButtonStyle}"
                            AutomationProperties.Name="Customize icon hover glow"
                            Click="GlowRow_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource EffectThumbStyle}">
                                <Grid>
                                    <Image x:Name="GlowThumb" Width="44" Height="44" Stretch="Fill" />
                                    <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="#F2C94C" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Icon hover glow" />
                                <TextBlock x:Name="GlowSummary" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Margin="76,0,0,0"
                                      Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>
                    <ToggleSwitch x:Name="GlowToggle"
                                  Style="{StaticResource EffectRowToggleSwitchStyle}"
                                  AutomationProperties.Name="Icon hover glow"
                                  IsOn="True"
                                  Toggled="GlowToggle_Toggled" />
                </Grid>
            </Border>

            <!-- ── Cursor click effect row ─────────────────────────────────── -->
            <Border Style="{StaticResource EffectRowCardStyle}">
                <Grid>
                    <Button Style="{StaticResource EffectRowButtonStyle}"
                            AutomationProperties.Name="Customize cursor click effect"
                            Click="ClickRow_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource EffectThumbStyle}">
                                <Grid>
                                    <Ellipse x:Name="ClickThumbRing" Width="26" Height="26"
                                             StrokeThickness="2" Stroke="#0078D4" />
                                    <Ellipse Width="5" Height="5" Fill="#E6E6E6" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Cursor click effect" />
                                <TextBlock x:Name="ClickSummary" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Margin="76,0,0,0"
                                      Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>
                    <ToggleSwitch x:Name="ClickToggle"
                                  Style="{StaticResource EffectRowToggleSwitchStyle}"
                                  AutomationProperties.Name="Cursor click effect"
                                  IsOn="True"
                                  Toggled="ClickToggle_Toggled" />
                </Grid>
            </Border>

            <!-- ── ICON LABELS (a single switch, so no page of its own) ────── -->
            <TextBlock Text="ICON LABELS" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D2;" Style="{StaticResource SettingIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Show icon names" />
                        <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                   Text="Show or hide the text under each desktop icon. Takes effect right away." />
                    </StackPanel>
                    <ToggleSwitch x:Name="ShowLabelsToggle" Grid.Column="2"
                                  Style="{StaticResource RowToggleSwitchStyle}"
                                  IsOn="True"
                                  Toggled="ShowLabelsToggle_Toggled" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
