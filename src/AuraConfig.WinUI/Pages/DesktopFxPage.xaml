<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.DesktopFxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AuraConfig.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16">

            <StackPanel Margin="0,0,0,4">
                <TextBlock FontSize="40" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Text="Desktop FX" />
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                           Text="Customize hover glow and click effects on the desktop"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- HOVER GLOW section header -->
            <TextBlock Text="HOVER GLOW"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Icon Hover Glow" />
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="A colored glow fades in around desktop icons when you hover over them."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <ToggleSwitch x:Name="GlowToggle"
                                  Header="Enable desktop icon hover glow"
                                  IsOn="True"
                                  Toggled="GlowToggle_Toggled" />

                    <!-- Color picker row -->
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Glow color" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox x:Name="HexInput"
                                     PlaceholderText="#FF8C00"
                                     Width="140"
                                     IsEnabled="{x:Bind GlowToggle.IsOn, Mode=OneWay}"
                                     KeyDown="HexInput_KeyDown" />
                            <Button Content="Apply"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind GlowToggle.IsOn, Mode=OneWay}"
                                    Click="ApplyHex_Click" />
                            <Button Padding="3"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    IsEnabled="{x:Bind GlowToggle.IsOn, Mode=OneWay}"
                                    Click="ColorPreview_Click">
                                <Border x:Name="ColorPreview"
                                        Width="22" Height="22"
                                        CornerRadius="3"
                                        Background="#FF8C00"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Glow style -->
                    <ComboBox x:Name="GlowStyleBox"
                              Header="Glow style"
                              MinWidth="320"
                              IsEnabled="{x:Bind GlowToggle.IsOn, Mode=OneWay}"
                              SelectionChanged="GlowStyleBox_Changed">
                        <ComboBoxItem Content="Solid — the chosen color" Tag="Solid" IsSelected="True" />
                        <ComboBoxItem Content="Color cycle — slowly shifts through the rainbow" Tag="ColorCycle" />
                        <ComboBoxItem Content="Pulse — gently brightens and dims" Tag="Pulse" />
                    </ComboBox>
                    <StackPanel x:Name="CycleControls" Visibility="Collapsed" Spacing="4">
                        <Slider x:Name="CycleSecondsSlider"
                                Header="Cycle length (seconds)"
                                Minimum="1" Maximum="20" StepFrequency="1" Value="6"
                                IsEnabled="{x:Bind GlowToggle.IsOn, Mode=OneWay}"
                                ValueChanged="CycleSecondsSlider_Changed" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                   Text="Time for one full color cycle or one pulse."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CLICK EFFECT section header -->
            <TextBlock Text="CLICK EFFECT"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold"
                       Margin="0,8,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Click Burst" />
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="A short burst plays at the mouse tip when you press the left button. It uses the glow color, including color cycling."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <ToggleSwitch x:Name="ClickToggle"
                                  Header="Enable click burst"
                                  IsOn="True"
                                  Toggled="ClickToggle_Toggled" />

                    <ComboBox x:Name="ClickStyleBox"
                              Header="Burst style"
                              MinWidth="320"
                              IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}"
                              SelectionChanged="ClickStyleBox_Changed">
                        <ComboBoxItem Content="Ring — an expanding ripple" Tag="Ring" />
                        <ComboBoxItem Content="Sparks — dots flying outward" Tag="Sparks" />
                        <ComboBoxItem Content="Ring and sparks" Tag="RingAndSparks" IsSelected="True" />
                    </ComboBox>

                    <Slider x:Name="ClickSizeSlider"
                            Header="Burst size (px)"
                            Minimum="20" Maximum="120" StepFrequency="4" Value="48"
                            IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}"
                            ValueChanged="ClickSizeSlider_Changed" />

                    <Slider x:Name="ClickDurationSlider"
                            Header="Burst length (ms)"
                            Minimum="200" Maximum="1200" StepFrequency="50" Value="450"
                            IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}"
                            ValueChanged="ClickDurationSlider_Changed" />

                    <ToggleSwitch x:Name="ClickDesktopOnlyToggle"
                                  Header="Only when clicking the desktop"
                                  OnContent="Desktop only" OffContent="Everywhere"
                                  IsOn="True"
                                  IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}"
                                  Toggled="ClickDesktopOnlyToggle_Toggled" />

                    <Button Content="Preview burst"
                            IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}"
                            Click="PreviewBurst_Click" />
                </StackPanel>
            </Border>

            <!-- APPEARANCE section header -->
            <TextBlock Text="APPEARANCE"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold"
                       Margin="0,8,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Glow Shape &amp; Size" />

                    <Slider x:Name="GlowSizeSlider"
                            Header="Glow radius (px)"
                            Minimum="4" Maximum="40" StepFrequency="2" Value="14"
                            IsEnabled="{x:Bind GlowToggle.IsOn, Mode=OneWay}"
                            ValueChanged="GlowSizeSlider_Changed" />

                    <Slider x:Name="IntensitySlider"
                            Header="Glow brightness"
                            Minimum="0" Maximum="100" StepFrequency="5" Value="80"
                            IsEnabled="{x:Bind GlowToggle.IsOn, Mode=OneWay}"
                            ValueChanged="IntensitySlider_Changed" />
                </StackPanel>
            </Border>

            <!-- ANIMATION section header -->
            <TextBlock Text="ANIMATION"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold"
                       Margin="0,8,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Fade Speed" />
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="Controls how quickly the glow fades in and out when hovering."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <Slider x:Name="FadeSpeedSlider"
                            Minimum="20" Maximum="300" StepFrequency="10" Value="100"
                            IsEnabled="{x:Bind GlowToggle.IsOn, Mode=OneWay}"
                            ValueChanged="FadeSpeedSlider_Changed" />
                    <Grid>
                        <TextBlock Text="Slow" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="Fast" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ICON LABELS section header -->
            <TextBlock Text="ICON LABELS"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold"
                       Margin="0,8,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Icon Label Visibility" />
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="Show or hide the text labels displayed beneath each desktop icon. Takes effect immediately."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <ToggleSwitch x:Name="ShowLabelsToggle"
                                  Header="Show icon labels"
                                  IsOn="True"
                                  Toggled="ShowLabelsToggle_Toggled" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
