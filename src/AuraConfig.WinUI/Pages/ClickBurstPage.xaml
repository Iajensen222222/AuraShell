<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.ClickBurstPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AuraConfig.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">

            <!-- ── Breadcrumb header: Desktop FX › Cursor click effect ─────── -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Padding="4,0"
                        AutomationProperties.Name="Back to Desktop FX"
                        Click="Back_Click">
                    <TextBlock Style="{StaticResource BreadcrumbParentTextStyle}" Text="Desktop FX" />
                </Button>
                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14" Margin="8,4,8,0"
                          Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Style="{StaticResource BreadcrumbTitleTextStyle}" Text="Cursor click effect" />
                <ToggleSwitch x:Name="ClickToggle" Grid.Column="3"
                              Style="{StaticResource RowToggleSwitchStyle}"
                              AutomationProperties.Name="Cursor click effect"
                              IsOn="True"
                              Toggled="ClickToggle_Toggled" />
            </Grid>

            <!-- ── Live preview and starting looks ────────────────────────── -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource EffectPreviewStyle}">
                    <Grid>
                        <!-- The transparent fill makes the whole area clickable. -->
                        <Canvas x:Name="PreviewCanvas" Width="264" Height="132"
                                Background="#00000000"
                                PointerPressed="PreviewCanvas_PointerPressed" />
                        <TextBlock Text="Click here to try it"
                                   IsHitTestVisible="False"
                                   Margin="12,0,0,10"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                   FontSize="12" Foreground="#99FFFFFF" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                               Text="A short burst plays at the mouse pointer when you left-click, in your glow color. Start from a look:" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Quick tap" Tag="Tap"     Click="Look_Click" IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}" />
                        <Button Content="Splash"    Tag="Splash"  Click="Look_Click" IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}" />
                        <Button Content="Sparkle"   Tag="Sparkle" Click="Look_Click" IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Water drop" Tag="Drop"     Click="Look_Click" IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}" />
                        <Button Content="Party"      Tag="Party"    Click="Look_Click" IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}" />
                        <Button Content="Firework"   Tag="Firework" Click="Look_Click" IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Play on screen"
                                ToolTipService.ToolTip="Play the burst at the mouse pointer now"
                                IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}"
                                Click="PreviewBurst_Click" />
                        <Button Content="Change color…"
                                Style="{StaticResource SubtleButtonStyle}"
                                Foreground="{StaticResource AccentTextFillColorPrimaryBrush}"
                                Click="ChangeColor_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ── BURST ──────────────────────────────────────────────────── -->
            <TextBlock Text="BURST" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE81C;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Burst style" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                       Text="Rings, sparks, ripples, light rays, confetti or a small firework." />
                        </StackPanel>
                        <ComboBox x:Name="ClickStyleBox" Grid.Column="2"
                                  MinWidth="180" Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Burst style"
                                  IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}"
                                  SelectionChanged="ClickStyleBox_Changed">
                            <ComboBoxItem Content="Ring" Tag="Ring" />
                            <ComboBoxItem Content="Sparks" Tag="Sparks" />
                            <ComboBoxItem Content="Ring and sparks" Tag="RingAndSparks" IsSelected="True" />
                            <ComboBoxItem Content="Ripple" Tag="Ripple" />
                            <ComboBoxItem Content="Light rays" Tag="Rays" />
                            <ComboBoxItem Content="Confetti" Tag="Confetti" />
                            <ComboBoxItem Content="Firework" Tag="Firework" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource CardDividerStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE740;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Burst size" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                       Text="How wide the burst grows." />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource SliderValueTextStyle}"
                                   Text="{x:Bind local:Fmt.Px(ClickSizeSlider.Value), Mode=OneWay}" />
                        <Slider x:Name="ClickSizeSlider" Grid.Column="3"
                                Style="{StaticResource RowSliderStyle}"
                                AutomationProperties.Name="Burst size in pixels"
                                Minimum="20" Maximum="120" StepFrequency="4" Value="48"
                                IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}"
                                ValueChanged="ClickSizeSlider_Changed" />
                    </Grid>

                    <Border Style="{StaticResource CardDividerStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE916;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Burst length" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                       Text="How long the burst stays on screen." />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource SliderValueTextStyle}"
                                   Text="{x:Bind local:Fmt.Ms(ClickDurationSlider.Value), Mode=OneWay}" />
                        <Slider x:Name="ClickDurationSlider" Grid.Column="3"
                                Style="{StaticResource RowSliderStyle}"
                                AutomationProperties.Name="Burst length in milliseconds"
                                Minimum="200" Maximum="1200" StepFrequency="50" Value="450"
                                IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}"
                                ValueChanged="ClickDurationSlider_Changed" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── WHERE IT SHOWS ─────────────────────────────────────────── -->
            <TextBlock Text="WHERE IT SHOWS" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Only on the desktop" />
                        <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                   Text="Turn off to show the burst on every click, in any app." />
                    </StackPanel>
                    <ToggleSwitch x:Name="ClickDesktopOnlyToggle" Grid.Column="2"
                                  Style="{StaticResource RowToggleSwitchStyle}"
                                  IsOn="True"
                                  IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}"
                                  Toggled="ClickDesktopOnlyToggle_Toggled" />
                </Grid>
            </Border>

            <!-- ── RESET ──────────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE777;" Style="{StaticResource SettingIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Reset this effect" />
                        <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                   Text="Put style, size and length back to default." />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Reset" Margin="16,0,0,0"
                            IsEnabled="{x:Bind ClickToggle.IsOn, Mode=OneWay}"
                            Click="Reset_Click" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
