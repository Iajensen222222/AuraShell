<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AuraConfig.Pages.AppColorsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">

            <StackPanel Margin="0,0,0,4">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="App Colors" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                           Text="Give individual apps their own border glow color, so you can tell them apart at a glance." />
            </StackPanel>

            <!-- ── ADD AN APP ─────────────────────────────────────────────── -->
            <TextBlock Text="ADD AN APP" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border x:Name="ExeDropZone"
                    Background="{StaticResource AppDropZoneBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24,20"
                    AllowDrop="True"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE8B5;" FontSize="28"
                              Foreground="{StaticResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Drop an app's .exe file here"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="Tip: right-click a shortcut, choose Open file location, then drag the .exe in."
                               Style="{StaticResource SettingDescriptionTextStyle}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Button Content="Browse for an app…"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Click="BrowseApp_Click" />
                </StackPanel>
            </Border>

            <!-- Color picker card (shown once an app is picked or Edit is clicked) -->
            <Border x:Name="ColorPickerCard"
                    Style="{StaticResource CardStyle}"
                    BorderBrush="{StaticResource AccentTextFillColorPrimaryBrush}"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xECAA;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedExeText"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                       Text="Choose a color for this app's window border, then save." />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="8"
                                ToolTipService.ToolTip="Close without saving"
                                AutomationProperties.Name="Close without saving"
                                Click="CancelOverride_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <StackPanel Spacing="8" Margin="40,0,0,0">
                        <TextBlock Text="Presets" Style="{StaticResource SettingDescriptionTextStyle}" />
                        <ItemsControl x:Name="PresetSwatches">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="Or a custom color" Style="{StaticResource SettingDescriptionTextStyle}"
                                   Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Padding="3"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Open color picker"
                                    AutomationProperties.Name="Open color picker"
                                    Click="AppColorPreview_Click">
                                <Border x:Name="AppColorPreview" Width="26" Height="26"
                                        CornerRadius="3" Background="#FF0078D4" />
                            </Button>
                            <TextBox x:Name="AppHexInput" PlaceholderText="#0078D4" Width="110"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="App color hex code"
                                     KeyDown="AppHexInput_KeyDown" />
                            <Button Content="Preview" Click="ApplyHex_Click"
                                    ToolTipService.ToolTip="Show this hex code in the swatch" />
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Save color"
                            Margin="40,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SaveOverride_Click" />
                </StackPanel>
            </Border>

            <!-- Status banner -->
            <Border x:Name="StatusBanner"
                    Background="{StaticResource SystemFillColorSuccessBackgroundBrush}"
                    CornerRadius="4" Padding="12,8" Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="13"
                              Foreground="{StaticResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{StaticResource SystemFillColorSuccessBrush}" />
                </StackPanel>
            </Border>

            <!-- ── YOUR APPS ──────────────────────────────────────────────── -->
            <TextBlock Text="YOUR APPS" Style="{StaticResource SectionHeaderTextStyle}" />
            <StackPanel x:Name="AppColorList" Spacing="4" />
            <Border x:Name="EmptyState"
                    Style="{StaticResource CardStyle}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" Style="{StaticResource SettingIconStyle}"
                              Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="No apps yet" />
                        <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                   Text="Every app uses your theme color until you add it above." />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
