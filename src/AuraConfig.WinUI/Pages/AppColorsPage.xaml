<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AuraConfig.Pages.AppColorsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16">

            <!-- Header -->
            <StackPanel Margin="0,0,0,4">
                <TextBlock FontSize="40" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display" Text="App Colors" />
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                           Text="Give specific apps a unique glow color on their window borders"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- ASSIGNED APPS -->
            <TextBlock Text="ASSIGNED APPS"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold" />
            <StackPanel x:Name="AppColorList" Spacing="8" />
            <TextBlock x:Name="EmptyState"
                       Text="No overrides yet — drop an .exe file below to add one."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="Collapsed" />

            <!-- ADD OVERRIDE -->
            <TextBlock Text="ADD OVERRIDE"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold"
                       Margin="0,8,0,0" />

            <!-- Drop zone -->
            <Border x:Name="ExeDropZone"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Height="120"
                    AllowDrop="True"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    Drop="DropZone_Drop">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8EF;" FontSize="32"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Drop an .exe file here"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Or use the browse button below"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Button Content="Browse for app…" Click="BrowseApp_Click" HorizontalAlignment="Left" />

            <!-- Color picker card (hidden until exe is picked) -->
            <Border x:Name="ColorPickerCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20"
                    Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   CharacterSpacing="50" FontWeight="SemiBold"
                                   Text="SELECTED APP" />
                        <TextBlock x:Name="SelectedExeText"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   CharacterSpacing="50" FontWeight="SemiBold"
                                   Text="CHOOSE COLOR" />
                        <ItemsControl x:Name="PresetSwatches">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="AppHexInput" PlaceholderText="#0078D4" Width="130" />
                            <Button Content="Apply" Click="ApplyHex_Click" />
                            <Border x:Name="AppColorPreview" Width="28" Height="28"
                                    CornerRadius="4" Background="#FF0078D4"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Save override"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="SaveOverride_Click" />
                </StackPanel>
            </Border>

            <!-- Status banner -->
            <Border x:Name="StatusBanner"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                <TextBlock x:Name="StatusText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
