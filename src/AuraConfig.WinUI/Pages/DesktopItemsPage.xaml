<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.DesktopItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16">

            <!-- Page header -->
            <StackPanel Margin="0,0,0,4">
                <TextBlock FontSize="40" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Text="Desktop Items" />
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                           Text="Customise shortcut and folder icons"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Coming soon info card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12" Orientation="Horizontal">
                    <FontIcon Glyph="&#xE946;"
                              FontSize="24"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              VerticalAlignment="Center" />
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Text="Desktop icon customization coming in v1.1" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="This feature is under development. Drop a shortcut or folder below to preview." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- DROP ZONE section -->
            <TextBlock Text="DROP ZONE"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold" />

            <!-- File drop zone -->
            <Border x:Name="DropZone"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12"
                    AllowDrop="True"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    Drop="DropZone_Drop"
                    Height="180">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE8EF;"
                              FontSize="40"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Drag a .lnk shortcut or folder here"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="or use the button below to browse for a file"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Browse button -->
            <Button Content="Browse for icon…"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="BrowseIcon_Click"
                    HorizontalAlignment="Left" />

            <!-- Selected item card (hidden until file selected) -->
            <Border x:Name="CurrentItemCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20"
                    Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Selected Item" />
                    <TextBlock x:Name="SelectedPathText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apply"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="ApplyIcon_Click" />
                        <Button Content="Restore Default"
                                Click="RestoreDefault_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
