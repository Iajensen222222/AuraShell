<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.DesktopItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">

            <StackPanel Margin="0,0,0,4">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Desktop Items" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                           Text="Give a desktop shortcut a different icon, and put it back whenever you like." />
            </StackPanel>

            <!-- Preview note -->
            <Border Background="{StaticResource AppAccentSubtleBrush}"
                    CornerRadius="4" Padding="12,8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="14" Margin="0,1,10,0"
                              VerticalAlignment="Top"
                              Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Text="Preview: this works with shortcut (.lnk) files today. Folder icons and more options are coming in v1.1." />
                </Grid>
            </Border>

            <!-- ── STEP 1 ─────────────────────────────────────────────────── -->
            <TextBlock Text="1  ·  CHOOSE A SHORTCUT" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border x:Name="DropZone"
                    Background="{StaticResource AppDropZoneBrush}"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24,20"
                    AllowDrop="True"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE71B;" FontSize="28"
                              Foreground="{StaticResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="Drag a shortcut from your desktop and drop it here"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                               Text="Shortcuts are the icons with a small arrow in the corner."
                               HorizontalAlignment="Center" />
                    <Button Content="Browse for a shortcut…"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Click="BrowseShortcut_Click" />
                </StackPanel>
            </Border>

            <!-- ── STEP 2 (shown once a shortcut is chosen) ───────────────── -->
            <StackPanel x:Name="CurrentItemCard" Visibility="Collapsed" Spacing="4">
                <TextBlock Text="2  ·  PICK A NEW ICON" Style="{StaticResource SectionHeaderTextStyle}" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE71B;" Style="{StaticResource SettingIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Shortcut" />
                                <TextBlock x:Name="SelectedPathText"
                                           Style="{StaticResource SettingDescriptionTextStyle}"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CardDividerStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B9;" Style="{StaticResource SettingIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="New icon" />
                                <TextBlock x:Name="IconSourceText"
                                           Style="{StaticResource SettingDescriptionTextStyle}"
                                           Text="No icon selected" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Choose icon…"
                                    Margin="16,0,0,0"
                                    ToolTipService.ToolTip="An .ico file, or an .exe or .dll that contains icons"
                                    Click="BrowseIcon_Click" />
                        </Grid>

                        <Border Style="{StaticResource CardDividerStyle}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="40,0,0,0">
                            <Button x:Name="ApplyBtn"
                                    Content="Apply icon"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="False"
                                    Click="ApplyIcon_Click" />
                            <Button Content="Restore original icon"
                                    Click="RestoreDefault_Click" />
                        </StackPanel>

                        <TextBlock x:Name="ResultText"
                                   Margin="40,0,0,0"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
