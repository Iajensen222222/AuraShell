<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.DesktopItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16">

            <!-- Page header -->
            <StackPanel Margin="0,0,0,4">
                <TextBlock FontSize="40" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Text="Desktop Items" />
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                           Text="Customise shortcut and folder icons"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- STEP 1: Pick target shortcut -->
            <TextBlock Text="1 — SELECT TARGET SHORTCUT"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold" />

            <Border x:Name="DropZone"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12"
                    AllowDrop="True"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    Drop="DropZone_Drop"
                    Height="140">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE8EF;"
                              FontSize="36"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Drag a .lnk shortcut here"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="Desktop shortcuts, taskbar pins — any .lnk file"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Button Content="Browse shortcut…"
                    Click="BrowseShortcut_Click"
                    HorizontalAlignment="Left" />

            <!-- STEP 2: Pick icon source (hidden until shortcut selected) -->
            <Border x:Name="CurrentItemCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20"
                    Visibility="Collapsed">
                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   CharacterSpacing="50" FontWeight="SemiBold"
                                   Text="TARGET SHORTCUT" />
                        <TextBlock x:Name="SelectedPathText"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   CharacterSpacing="50" FontWeight="SemiBold"
                                   Text="2 — CHOOSE NEW ICON" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Browse icon…"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="BrowseIcon_Click" />
                            <TextBlock x:Name="IconSourceText"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Text="No icon selected"
                                       TextWrapping="Wrap"
                                       MaxWidth="400" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ApplyBtn"
                                Content="Apply icon"
                                Style="{ThemeResource AccentButtonStyle}"
                                IsEnabled="False"
                                Click="ApplyIcon_Click" />
                        <Button Content="Restore default"
                                Click="RestoreDefault_Click" />
                    </StackPanel>

                    <TextBlock x:Name="ResultText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Visibility="Collapsed"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
