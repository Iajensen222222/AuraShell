<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AuraConfig.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock
                FontSize="40" FontWeight="SemiBold"
                FontFamily="Segoe UI Variable Display"
                Text="Presets" />
            <TextBlock
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Choose your Aura glow"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,2,0,0" />
        </StackPanel>

        <!-- Status bar strip -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,8"
            Margin="0,12,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Ellipse
                        x:Name="StatusDot"
                        Width="8" Height="8"
                        Fill="{ThemeResource SystemFillColorCautionBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="StatusText"
                        Text="Service not connected"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ThemeNameText"
                        Text=""
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="ReconnectBtn"
                        Content="Reconnect"
                        Visibility="Collapsed"
                        Click="ReconnectBtn_Click"
                        Padding="8,2"
                        FontSize="11"
                        CornerRadius="4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preset gallery — using standard {Binding} (no x:DataType) for reliability -->
        <GridView
            Grid.Row="2"
            x:Name="PresetsGrid"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="PresetsGrid_ItemClick">

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Width="296" Height="196"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="50" />
                            </Grid.RowDefinitions>

                            <!-- Glow preview — coloured via code-behind tag -->
                            <Border
                                Grid.Row="0"
                                x:Name="GlowBg"
                                Tag="{Binding}"
                                CornerRadius="12,12,0,0"
                                Background="#0C0D14" />

                            <!-- Name + hex + apply chip -->
                            <Grid Grid.Row="1" Padding="14,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{Binding HexColor}"
                                        FontFamily="Cascadia Code"
                                        FontSize="10"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    VerticalAlignment="Center"
                                    Background="#20FFFFFF">
                                    <TextBlock
                                        Text="Apply"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Applied banner -->
        <Border
            Grid.Row="3"
            x:Name="AppliedBanner"
            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
            CornerRadius="8"
            Padding="16,10"
            Margin="0,12,0,0"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE73E;" FontSize="14"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock
                    x:Name="AppliedText"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            </StackPanel>
        </Border>
        <!-- Live performance stats -->
        <Border
            Grid.Row="5"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,8"
            Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <TextBlock x:Name="CpuText" Text="CPU: --"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="MemText" Text="MEM: --"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="FpsText" Text="FPS: --"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Desktop shortcut button -->
        <Button
            Grid.Row="4"
            x:Name="CreateShortcutBtn"
            Click="CreateShortcut_Click"
            HorizontalAlignment="Left"
            Margin="0,10,0,0"
            Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE71B;" FontSize="14" />
                <TextBlock Text="Create desktop shortcut" FontSize="13" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
