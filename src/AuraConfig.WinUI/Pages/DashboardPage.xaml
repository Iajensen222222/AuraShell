<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AuraConfig.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0: header -->
            <RowDefinition Height="Auto" />  <!-- 1: status bar -->
            <RowDefinition Height="Auto" />  <!-- 2: toolbar -->
            <RowDefinition Height="*"    />  <!-- 3: grid + empty state -->
            <RowDefinition Height="Auto" />  <!-- 4: applied banner -->
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock
                FontSize="40" FontWeight="SemiBold"
                FontFamily="Segoe UI Variable Display"
                Text="Presets" />
            <TextBlock
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Choose your Aura glow"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,2,0,0" />
        </StackPanel>

        <!-- Named perf-stat TextBlocks kept for code-behind compatibility; not shown -->
        <StackPanel Grid.Row="1" Visibility="Collapsed">
            <TextBlock x:Name="CpuText" />
            <TextBlock x:Name="MemText" />
            <TextBlock x:Name="FpsText" />
            <TextBlock x:Name="ThemeNameText" />
        </StackPanel>

        <!-- Toolbar: search + add + desktop shortcut -->
        <Grid Grid.Row="2" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                PlaceholderText="Search presets…"
                TextChanged="SearchBox_TextChanged" />

            <Button Grid.Column="1" Margin="8,0,0,0" Click="AddItemBtn_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                    <TextBlock Text="New Preset" FontSize="13" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Margin="8,0,0,0" Click="CreateShortcut_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71B;" FontSize="13" />
                    <TextBlock Text="Desktop shortcut" FontSize="13" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Margin="8,0,0,0" Click="ImportPresets_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8B5;" FontSize="13" />
                    <TextBlock Text="Import All" FontSize="13" />
                </StackPanel>
            </Button>

            <Button Grid.Column="4" Margin="4,0,0,0" Click="ExportPresets_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                    <TextBlock Text="Export All" FontSize="13" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyState"
                   Grid.Row="3"
                   Text="No presets match your search."
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <!-- Preset gallery -->
        <GridView
            Grid.Row="3"
            x:Name="PresetsGrid"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="PresetsGrid_ItemClick"
            CanDragItems="True"
            CanReorderItems="True"
            AllowDrop="True"
            DragItemsCompleted="PresetsGrid_DragItemsCompleted">

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemTemplate>
                <DataTemplate>
                    <!--
                        Structure required by OnContainerContentChanging:
                          ContentTemplateRoot = outerBorder (Border)
                          outerBorder.Child   = Grid
                          grid.Children[0]    = preview Border
                          grid.Children[1]    = infoRow Grid
                            infoRow.Children[0] = chip Border (mode badge)
                            infoRow.Children[1] = name+hex StackPanel
                            infoRow.Children[2] = desc TextBlock (Tag="desc")
                            infoRow.Children[3] = three-dots Button
                    -->
                    <Border
                        Width="296" Height="196"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="56" />
                            </Grid.RowDefinitions>

                            <!-- grid.Children[0]: glow preview, painted by code-behind -->
                            <Border
                                Grid.Row="0"
                                CornerRadius="10,10,0,0"
                                Background="#0C0D14" />

                            <!-- grid.Children[1]: info row
                                 No column definitions — all children share the same cell.
                                 Chip (Children[0]) anchors top-left; name (Children[1])
                                 centres vertically; button (Children[3]) anchors right.
                                 Padding="14,0,8,0" gives consistent left indent matching
                                 the card's corner radius. -->
                            <Grid Grid.Row="1" Padding="14,0,8,0">

                                <!-- infoRow.Children[0]: mode chip — right side, beside the three-dots button -->
                                <Border
                                    CornerRadius="4"
                                    Padding="6,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,44,0"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        FontSize="9"
                                        FontWeight="SemiBold" />
                                </Border>

                                <!-- infoRow.Children[1]: name — centred, right margin avoids button -->
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Margin="0,0,36,0">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- infoRow.Children[2]: description (Tag="desc", hidden until set) -->
                                <TextBlock
                                    Tag="desc"
                                    Text="{Binding Description}"
                                    FontSize="10"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,36,7"
                                    Visibility="Collapsed" />

                                <!-- infoRow.Children[3]: three-dots menu — anchors right -->
                                <Button
                                    Tag="{Binding}"
                                    Click="ThreeDotsBtn_Click"
                                    Width="32" Height="32"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Applied banner -->
        <Border
            Grid.Row="4"
            x:Name="AppliedBanner"
            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
            CornerRadius="8"
            Padding="16,10"
            Margin="0,12,0,0"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE73E;" FontSize="14"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock
                    x:Name="AppliedText"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
