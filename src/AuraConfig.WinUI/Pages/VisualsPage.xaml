<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.VisualsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AuraConfig.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16">

            <StackPanel Margin="0,0,0,4">
                <TextBlock FontSize="40" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Text="Visuals" />
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                           Text="Customize your Aura glow experience"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- COLOUR card -->
            <TextBlock Text="COLOUR"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Accent Color" />
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="Select a preset colour on the Dashboard, or enter a hex code below."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="HexInput"
                                 PlaceholderText="#00F2FF"
                                 Width="140"
                                 KeyDown="HexInput_KeyDown" />
                        <Button Content="Apply" Click="ApplyHex_Click"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ANIMATION card -->
            <TextBlock Text="ANIMATION"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold"
                       Margin="0,8,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="20">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Glow Animation" />
                    <Slider x:Name="SpeedSlider"
                            Minimum="0" Maximum="200"
                            Value="100"
                            Header="Pulse Speed"
                            ValueChanged="SpeedSlider_ValueChanged" />
                </StackPanel>
            </Border>

            <!-- IDLE BREATHING card -->
            <TextBlock Text="IDLE BREATHING"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold"
                       Margin="0,8,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Border Breathing Animation" />
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="Make every window border pulse gently in the background."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <ComboBox x:Name="BreatheModeBox"
                              Header="Mode"
                              MinWidth="320"
                              SelectionChanged="BreatheMode_Changed">
                        <ComboBoxItem Content="Disabled" Tag="0" IsSelected="True" />
                        <ComboBoxItem Content="Synchronized — all borders pulse together" Tag="1" />
                        <ComboBoxItem Content="Wave — pulse rolls left to right" Tag="2" />
                    </ComboBox>
                    <StackPanel x:Name="BreatheControls" Visibility="Collapsed" Spacing="8">
                        <Slider x:Name="BreatheSpeedSlider"
                                Header="Speed"
                                Minimum="0.5" Maximum="5.0" StepFrequency="0.1" Value="2.5"
                                ValueChanged="BreatheSpeed_Changed" />
                        <TextBlock x:Name="BreatheSpeedLabel"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="2.5 s per cycle" />
                        <Slider x:Name="BreatheBrightnessSlider"
                                Header="Max brightness boost"
                                Minimum="0" Maximum="100" StepFrequency="5" Value="40"
                                ValueChanged="BreatheBrightness_Changed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AUDIO VISUALIZER card -->
            <TextBlock Text="AUDIO VISUALIZER"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold"
                       Margin="0,8,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Live Audio Bands" />
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="Real-time frequency spectrum from the system audio."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Canvas x:Name="VisualizerCanvas"
                            Height="80"
                            HorizontalAlignment="Stretch"
                            Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- OPTIONS card -->
            <TextBlock Text="OPTIONS"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       CharacterSpacing="50" FontWeight="SemiBold"
                       Margin="0,8,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Overlay Behavior" />
                    <ToggleSwitch x:Name="HoverToggle"
                                  Header="Show overlay on hover"
                                  IsOn="True"
                                  Toggled="HoverToggle_Toggled" />
                    <ToggleSwitch x:Name="GlowToggle"
                                  Header="Enable glow effect"
                                  IsOn="True"
                                  Toggled="GlowToggle_Toggled" />
                </StackPanel>
            </Border>

            <!-- Save as theme shortcut -->
            <Button x:Name="SaveAsThemeBtn"
                    Click="SaveAsTheme_Click"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock Text="Save as theme…" FontSize="13" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
