<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuraConfig.Pages.DesktopLookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AuraConfig.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">

            <StackPanel Margin="0,0,0,4">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Wallpaper &amp; Colors" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                           Text="Change the Windows wallpaper, accent color and light or dark mode. AuraShell keeps your original look so you can always go back." />
            </StackPanel>

            <!-- Status message -->
            <Border x:Name="StatusBanner"
                    Background="{StaticResource SystemFillColorSuccessBackgroundBrush}"
                    CornerRadius="4" Padding="12,8"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="StatusIcon" Glyph="&#xE73E;" FontSize="13"
                              Foreground="{StaticResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{StaticResource SystemFillColorSuccessBrush}" />
                </StackPanel>
            </Border>

            <!-- ── WALLPAPER ──────────────────────────────────────────────── -->
            <TextBlock Text="WALLPAPER" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="240" Height="135" CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                                Background="{StaticResource AppSubtleHoverBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE91B;" FontSize="28" Opacity="0.4" />
                                <Image x:Name="WallpaperPreview" Stretch="UniformToFill"
                                       AutomationProperties.Name="Current wallpaper" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Current wallpaper" />
                                <TextBlock x:Name="WallpaperName"
                                           Style="{StaticResource SettingDescriptionTextStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="None" />
                            </StackPanel>
                            <Button x:Name="BrowseBtn"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="Browse_Click"
                                    ToolTipService.ToolTip="Pick an image and set it as your wallpaper">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Choose a picture…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource CardDividerStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE740;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Fit" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                       Text="How the picture fills your screen." />
                        </StackPanel>
                        <ComboBox x:Name="FitCombo" Grid.Column="2"
                                  Width="160" Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Wallpaper fit"
                                  SelectionChanged="FitCombo_SelectionChanged">
                            <ComboBoxItem Content="Fill" Tag="Fill" />
                            <ComboBoxItem Content="Fit" Tag="Fit" />
                            <ComboBoxItem Content="Stretch" Tag="Stretch" />
                            <ComboBoxItem Content="Tile" Tag="Tile" />
                            <ComboBoxItem Content="Center" Tag="Center" />
                            <ComboBoxItem Content="Span" Tag="Span" />
                        </ComboBox>
                    </Grid>
                    <StackPanel x:Name="RecentSection" Spacing="14" Visibility="Collapsed">
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE81C;" Style="{StaticResource SettingIconStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Recent pictures" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                           Text="Click one to use it again. Right-click to remove it from this list." />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="RecentPanel" Orientation="Horizontal" Spacing="8" Margin="40,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── MODE ───────────────────────────────────────────────────── -->
            <TextBlock Text="LIGHT AND DARK" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE793;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Windows mode" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                       Text="Light or dark for Windows and your apps. Custom sets them separately." />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="40,0,0,0">
                        <RadioButton x:Name="ModeLight" Content="Light" Tag="Light"
                                     GroupName="WindowsMode" Checked="ModeRadio_Checked" />
                        <RadioButton x:Name="ModeDark" Content="Dark" Tag="Dark"
                                     GroupName="WindowsMode" Checked="ModeRadio_Checked" />
                        <RadioButton x:Name="ModeCustom" Content="Custom" Tag="Custom"
                                     GroupName="WindowsMode" Checked="ModeRadio_Checked" />
                    </StackPanel>
                    <StackPanel x:Name="CustomModePanel" Spacing="14" Visibility="Collapsed">
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <Grid Margin="40,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Windows" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                           Text="Start, the taskbar and notifications." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <RadioButton x:Name="SystemLight" Content="Light" GroupName="SystemMode"
                                             Checked="CustomMode_Checked" />
                                <RadioButton x:Name="SystemDark" Content="Dark" GroupName="SystemMode"
                                             Checked="CustomMode_Checked" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <Grid Margin="40,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Apps" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                           Text="File Explorer, Settings and other apps that follow Windows." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <RadioButton x:Name="AppsLight" Content="Light" GroupName="AppsMode"
                                             Checked="CustomMode_Checked" />
                                <RadioButton x:Name="AppsDark" Content="Dark" GroupName="AppsMode"
                                             Checked="CustomMode_Checked" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── ACCENT ─────────────────────────────────────────────────── -->
            <TextBlock Text="ACCENT COLOR" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Windows accent color" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                       Text="Used by Start, buttons, links and highlights across Windows." />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                            <Button Padding="3"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Open color picker"
                                    AutomationProperties.Name="Open accent color picker"
                                    Click="AccentSwatch_Click">
                                <Border x:Name="AccentSwatch"
                                        Width="26" Height="26" CornerRadius="3"
                                        Background="#FF0078D4" />
                            </Button>
                            <TextBox x:Name="AccentHexInput"
                                     PlaceholderText="#0078D4"
                                     Width="110"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Accent color hex code"
                                     KeyDown="AccentHexInput_KeyDown" />
                            <Button Content="Set" Click="AccentHexSet_Click"
                                    ToolTipService.ToolTip="Use this hex code as the accent" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="AccentPresetPanel" Orientation="Horizontal" Spacing="6" Margin="40,0,0,0" />
                    <Border Style="{StaticResource CardDividerStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE771;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Match my AuraShell theme" />
                            <TextBlock x:Name="ThemeColorDescription"
                                       Style="{StaticResource SettingDescriptionTextStyle}"
                                       Text="Use your glow color as the Windows accent." />
                        </StackPanel>
                        <Button Grid.Column="2" Margin="16,0,0,0"
                                Click="UseThemeColor_Click"
                                ToolTipService.ToolTip="Set the Windows accent to your AuraShell glow color">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="ThemeColorSwatch"
                                        Width="14" Height="14" CornerRadius="7"
                                        VerticalAlignment="Center"
                                        Background="#FF0078D4" />
                                <TextBlock Text="Use theme color" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource CardDividerStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE75B;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Show accent on Start and taskbar" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                                       Text="Windows only shows this while Windows mode is dark." />
                        </StackPanel>
                        <ToggleSwitch x:Name="TaskbarAccentToggle" Grid.Column="2"
                                      Style="{StaticResource RowToggleSwitchStyle}"
                                      AutomationProperties.Name="Show accent on Start and taskbar"
                                      Toggled="AccentSurface_Toggled" />
                    </Grid>
                    <Border Style="{StaticResource CardDividerStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE737;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Show accent on title bars and window borders" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TitleBarAccentToggle" Grid.Column="2"
                                      Style="{StaticResource RowToggleSwitchStyle}"
                                      AutomationProperties.Name="Show accent on title bars and window borders"
                                      Toggled="AccentSurface_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── RESTORE ────────────────────────────────────────────────── -->
            <TextBlock Text="RESTORE" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE777;" Style="{StaticResource SettingIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitleTextStyle}" Text="Restore my original look" />
                        <TextBlock x:Name="RestoreDescription"
                                   Style="{StaticResource SettingDescriptionTextStyle}"
                                   Text="Put back the wallpaper, accent and modes you had before AuraShell changed them." />
                    </StackPanel>
                    <Button x:Name="RestoreBtn" Grid.Column="2" Content="Restore"
                            Margin="16,0,0,0"
                            Click="Restore_Click" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
